---
source: crates/owr-apply/src/tests.rs
expression: plans(&defaults()).dnsmasq_conf
---
# Generated by owr-apply. Do not edit; changes are overwritten.
domain-needed
bogus-priv
localise-queries
resolv-file=/run/ferritewrt/resolv.conf.auto
local=/lan/
domain=lan
expand-hosts
stop-dns-rebind
rebind-localhost-ok
interface=br-lan
bind-dynamic
except-interface=eth1
dhcp-authoritative
dhcp-range=set:lan,192.168.8.100,192.168.8.249,255.255.255.0,12h
dhcp-option=tag:lan,option:router,192.168.8.1
dhcp-option=tag:lan,option:dns-server,192.168.8.1
dhcp-leasefile=/run/ferritewrt/dhcp.leases
pid-file=/run/ferritewrt/dnsmasq.pid
cache-size=1000
dns-forward-max=300
edns-packet-max=1232
min-cache-ttl=0
