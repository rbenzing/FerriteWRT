---
source: crates/owr-apply/src/tests.rs
expression: plans(&cfg).odhcpd_conf
---
# Generated by owr-apply. Do not edit; changes are overwritten.
config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/run/ferritewrt/odhcpd.leases'
	option loglevel '4'

config dhcp 'lan'
	option interface 'lan'
	option ifname 'br-lan'
	option ra 'server'
	option dhcpv6 'server'
	option ra_flags 'managed-config other-config'
	option ndp 'disabled'
