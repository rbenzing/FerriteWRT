# ferritewrt: board part of the OpenWrt config for the GL.iNet GL-MT6000 (Flint 2).
# build-image.sh appends this to common.diffconfig (project-wide policy: images,
# hardening, busybox, removed packages, kept daemons, nft and input modules), so only
# what is specific to this device lives here. Every line is verified after
# "make defconfig". See docs/PORTING.md.
# Source: target/linux/mediatek/image/filogic.mk, define Device/glinet_gl-mt6000.

# --- target / device -----------------------------------------------------------
# One device, not TARGET_MULTI_PROFILE, so TARGET_PER_DEVICE_ROOTFS (which only exists
# in the multi-profile menu, scripts/target-metadata.pl:287) is not applicable.
# The profile choice defaults to openwrt_one (filogic target.mk), so it must be set here.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt6000=y

# --- device drivers and firmware (= kernel_modules + firmware_packages of
# boards/glinet_gl-mt6000.toml; the owr-board repo tests keep the two in sync) -----
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# --- storage tools for the f2fs overlay on eMMC ------------------------------------
# owr-init runs mkfs.f2fs on a blank rootfs_data; fsck and e2fsprogs for repair.
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y

# --- target defaults kept --------------------------------------------------------
# fitblk is hidden (selected through the filogic DEFAULT_PACKAGES) and is inert on
# the GL-MT6000, whose rootfs is not a FIT image. Candidate for removal in phase 2.
CONFIG_PACKAGE_fitblk=y
